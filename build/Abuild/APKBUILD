pkgname=lua5.4
_pkgname=lua
pkgver=5.4.7
_luaver=${pkgname#lua}
pkgrel=2
pkgdesc="Powerful lightweight programming language designed for extending applications"
url="https://www.lua.org/"
arch="all"
license="MIT"
depends="readline $pkgname-libs"
makedepends="readline-dev"
depends_dev="$pkgname"
subpackages="$pkgname-dev $pkgname-doc $pkgname-libs"
source="https://www.lua.org/ftp/$_pkgname-$pkgver.tar.gz
	lua.pc
	qnx-liblua-so.patch
	qnx-paths.patch
"
builddir="$srcdir/$_pkgname-$pkgver"

build() {
	# Prepare lua.pc
	if ! [[ -e $srcdir/lua.pc ]]; then
		die "Need lua.pc"
	fi
	sed "s/%VER%/$_luaver/g;s/%REL%/$pkgver/g" $srcdir/lua.pc > $srcdir/lua.pc.patched

	make MYCFLAGS="$CFLAGS -fPIC" MYLDFLAGS="$LDFLAGS"
}

check() {
	make test
}

package() {
	make \
	    TO_LIB="liblua.so liblua.so.$_luaver liblua.so.$pkgver" \
            INSTALL="install" \
	    INSTALL_TOP="$pkgdir"/usr \
            INSTALL_MAN="$pkgdir"/usr/share/man/man1 \
	    install
	ln -s lua $pkgdir/usr/bin/lua5.4

	install -Dm644 $srcdir/lua.pc.patched "$pkgdir"/usr/lib/pkgconfig/lua54.pc
	ln -sf lua54.pc "$pkgdir"/usr/lib/pkgconfig/lua.pc
	ln -sf lua54.pc "$pkgdir"/usr/lib/pkgconfig/lua5.4.pc
	ln -sf lua54.pc "$pkgdir"/usr/lib/pkgconfig/lua-5.4.pc

	install -d "$pkgdir"/usr/share/doc/$pkgname
	install -m644 doc/*.{gif,png,css,html} "$pkgdir"/usr/share/doc/$pkgname
}

